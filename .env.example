# NexIDE Environment Variables
# Copy this file to .env and fill in your values.
#
# Anything prefixed with VITE_ is compiled into the public JavaScript bundle.
# Only put values there that are safe for every visitor to read.

# ── Browser (public) ─────────────────────────────────────────────
# Supabase project URL and the *publishable* key (sb_publishable_… or the legacy anon JWT).
# NEVER use the service_role / sb_secret_ key here — it bypasses Row Level Security.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ── Server only (Vercel function /api/generate) ─────────────────
# Optional system Gemini key, used only for signed-in users without their own key.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional model override (default: gemini-2.5-flash)
GEMINI_MODEL=
# Optional per-user limits for the system key (defaults: 10/minute, 200/day)
AI_RATE_LIMIT_PER_MINUTE=
AI_RATE_LIMIT_PER_DAY=
# Optional shared rate-limit store (Upstash Redis REST, or Vercel KV's KV_REST_API_URL/TOKEN).
# Without it, limits apply per serverless instance only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# OpenCode Agent Server
OPENCODE_SERVER_URL=http://127.0.0.1:4096
OPENCODE_SERVER_PASSWORD=

# Supabase Service Role (server-only, for token accounting)
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay (server-only)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Global Protection
GLOBAL_DAILY_TOKEN_BUDGET=1000000
